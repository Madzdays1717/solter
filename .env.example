# Copy to .env, never commit .env or share Telegram bot token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public RPC may rate-limit; replace with a personal FREE-tier HTTPS/WSS RPC pair.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS_URL=wss://api.mainnet-beta.solana.com

# Strict, non-billable request ceilings, not third-party credit accounting.
RPC_REQUESTS_PER_MIN=30
RPC_REQUESTS_PER_DAY=1800
MAX_ACTIVE_TOKENS=5
WATCH_SECONDS=240
DEX_SECONDS_BETWEEN=4
MAX_CALLS_PER_HOUR=5
MIN_UNIQUE_BUYERS=5
MIN_BUYS=6
MAX_EVENT_LAG_SECONDS=35
REQUIRE_MINT_CHECK=true
