# Salin ke .env. Jangan pernah commit atau membagikan .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# RPC gratis. Default: RPC publik Solana. Untuk koneksi lebih stabil, isi endpoint free tier
# milik sendiri (HTTPS dan WSS dari provider yang sama).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS_URL=wss://api.mainnet-beta.solana.com

# Batas yang dijaga Solter sendiri (bukan hitungan kredit provider).
RPC_REQUESTS_PER_MIN=60
RPC_REQUESTS_PER_DAY=15000

# Reservoir dan pemantauan live
SWEEP_SECONDS=30              # jeda minimum antar sweep (otomatis lebih lambat jika budget kecil)
SWEEP_ACCOUNTS=200            # token per sweep (100 per request)
RESERVOIR_MINUTES=60          # token diperhatikan selama ini sejak launch
ALIVE_MIN_SOL=0.5             # SOL dari pembeli lain (di luar dev) agar dianggap hidup
PROMOTE_MIN_SOL=1.0           # minimal SOL komunitas untuk dapat slot live
PROMOTE_MIN_SOL_PER_MIN=0.5   # minimal laju inflow untuk dapat slot live
MAX_ACTIVE_TOKENS=16           # slot live (logsSubscribe)
WATCH_SECONDS=300             # lama satu slot (diperpanjang selama ada pembelian, maks 3x)
BACKFILL_TX=3                 # transaksi terakhir yang dibaca saat token mulai dipantau

# Gerbang aliran beli (jendela 3 menit)
MIN_BUYS=8
MIN_UNIQUE_BUYERS=6
MIN_NET_SOL=2.0
DUST_SOL=0.05                 # buy lebih kecil dari ini diabaikan
MAX_WALLET_SHARE_PCT=30       # porsi SOL pembeli terbesar
MAX_BUNDLE_SHARE_PCT=50       # porsi SOL dari slot berisi 3+ wallet
MAX_SELL_RATIO_PCT=60         # SOL jual dibanding SOL beli
MAX_EVENT_LAG_SECONDS=30      # buy terakhir harus sesegar ini
MAX_RUN_PCT=100               # kenaikan harga maksimum dalam jendela

# Gerbang kualitas
MAX_TOP10_PCT=30
MAX_HOLDER_PCT=10
MAX_DEV_PCT=10
MAX_DEV_BUY_PCT=15
MAX_CREATOR_LAUNCHES=3        # 0 = nonaktif
MAX_PROGRESS_PCT=85           # progres bonding curve maksimum
REQUIRE_SOCIALS=false
REQUIRE_MINT_CHECK=true
MIN_SCORE=0                   # 0-100; 0 = semua yang lolos filter di-call dengan grade A/B/C
MIN_LIQUIDITY_USD=5000        # untuk token yang sudah migrasi ke PumpSwap

# Call dan tindak lanjut
# Radar cepat: token baru tidak perlu masuk slot wallet/logs untuk tampil.
# DexScreener HTTP batch, tidak memakai transaksi berbayar PumpPortal.
RADAR_ENABLED=true
RADAR_INTERVAL_SECONDS=4
RADAR_BATCH_TOKENS=120
RADAR_TRACK_MINUTES=30
RADAR_MIN_MC_USD=3000
RADAR_MAX_MC_USD=150000
RADAR_MIN_VOLUME_5M_USD=750
RADAR_MIN_BUYS_5M=8
RADAR_MIN_BUY_SELL_RATIO=1.2
RADAR_MIN_MC_CHANGE_PCT=4
RADAR_MAX_ALERTS_PER_HOUR=60
# Hanya CALL yang telah diverifikasi memakai batas ini (RADAR terpisah).
MAX_CALLS_PER_HOUR=5
TRACK_MINUTES=60
FOLLOWUP_ALERTS=true          # balasan 2x/3x/5x/10x dan peringatan dev jual
DEX_SECONDS_BETWEEN=0.4

# v2.0.2: optional HTTPS fallback; no key is bundled.
SOLANA_RPC_FALLBACK_URL=
EVAL_CONCURRENCY=3
QUIET_SECONDS=60
