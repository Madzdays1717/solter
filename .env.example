# Salin ke .env. Jangan pernah commit atau membagikan .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Seberapa ketat aturan call:
#   ketat    = sedikit call, filter paling keras
#   seimbang = default
#   agresif  = lebih banyak call (lebih banyak juga yang gagal; lihat grade A/B/C di pesan)
CALL_MODE=seimbang

# RPC gratis. Default: RPC publik Solana. Untuk koneksi lebih stabil, isi endpoint free tier
# milik sendiri (HTTPS dan WSS dari provider yang sama).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS_URL=wss://api.mainnet-beta.solana.com

# Batas yang dijaga Solter sendiri (bukan hitungan kredit provider).
RPC_REQUESTS_PER_MIN=60
RPC_REQUESTS_PER_DAY=15000

# Reservoir dan pemantauan live
SWEEP_SECONDS=30              # jeda minimum antar sweep (otomatis lebih lambat jika budget kecil)
SWEEP_ACCOUNTS=200            # token per sweep (100 per request)
RESERVOIR_MINUTES=60          # token diperhatikan selama ini sejak launch
ALIVE_MIN_SOL=0.5             # SOL dari pembeli lain (di luar dev) agar dianggap hidup
MAX_ACTIVE_TOKENS=8           # slot live (logsSubscribe)
WATCH_SECONDS=300             # lama satu slot (diperpanjang selama ada pembelian, maks 3x)
BACKFILL_TX=3                 # transaksi terakhir yang dibaca saat token mulai dipantau
DUST_SOL=0.05                 # buy lebih kecil dari ini tidak dihitung sebagai pembeli
MAX_BUNDLE_SHARE_PCT=50       # porsi SOL dari slot berisi 3+ wallet
MAX_EVENT_LAG_SECONDS=30      # buy terakhir harus sesegar ini
MAX_DEV_BUY_PCT=15
MAX_CREATOR_LAUNCHES=3        # 0 = nonaktif
REQUIRE_SOCIALS=false
REQUIRE_MINT_CHECK=true
MIN_SCORE=0                   # 0-100; 0 = semua yang lolos filter di-call dengan grade A/B/C
MIN_LIQUIDITY_USD=5000        # untuk token yang sudah migrasi ke PumpSwap

# Call dan tindak lanjut
MAX_CALLS_PER_HOUR=5
TRACK_MINUTES=60
FOLLOWUP_ALERTS=true          # balasan 2x/3x/5x/10x dan peringatan dev jual
DEX_SECONDS_BETWEEN=1

# --- Diatur oleh CALL_MODE. Hapus tanda # hanya jika ingin menimpa satu angka. ---
# Nilai di bawah adalah mode seimbang (ketat / agresif di kurung).
# PROMOTE_MIN_SOL=0.8         # SOL komunitas minimal untuk slot live (1.0 / 0.5)
# PROMOTE_MIN_SOL_PER_MIN=0.4 # laju inflow minimal untuk slot live (0.5 / 0.3)
# MIN_BUYS=6                  # buy nyata dalam 3 menit (8 / 5)
# MIN_UNIQUE_BUYERS=5         # pembeli berbeda (6 / 4)
# MIN_NET_SOL=1.5             # SOL bersih masuk dalam 3 menit (2.0 / 1.0)
# MIN_VOLUME_SOL=4            # volume beli+jual dalam 3 menit (5 / 3)
# MAX_WALLET_SHARE_PCT=35     # porsi SOL pembeli terbesar (30 / 45)
# MAX_SELL_RATIO_PCT=70       # SOL jual dibanding SOL beli (60 / 80)
# MAX_CHURN_PCT=60            # porsi volume dari wallet yang beli lalu jual lagi = wash (50 / 70)
# MAX_RUN_PCT=200             # kenaikan harga maksimum dalam 3 menit (100 / 400)
# MIN_MCAP_USD=6000           # market cap minimum saat call (8000 / 5000)
# MAX_MCAP_USD=80000          # market cap maksimum saat call (40000 / 150000)
# MAX_TOP10_PCT=35            # 10 holder terbesar (30 / 45)
# MAX_HOLDER_PCT=12           # holder terbesar (10 / 15)
# MAX_DEV_PCT=10              # saldo dev sekarang (10 / 15)
# MAX_PROGRESS_PCT=95         # progres bonding curve maksimum (85 / 100)
